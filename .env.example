# FreeLLMAPI proxy (https://github.com/tashfeenahmed/freellmapi). Leave empty to use only the local model.
BASE_URL=http://127.0.0.1:31415
API_KEY=freellmapi-your-unified-key
MODEL=auto
# Microphone loudness threshold (0.0 to 1.0). Raise it if background noise starts recordings.
MIC_THRESHOLD=0.01
WAKE_WORD=edith
