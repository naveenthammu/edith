# Online brains, tried in order. Leave both empty to use only the offline model.
# 1. Claude (paid): key from https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# 2. FreeLLMAPI (free tiers): https://github.com/tashfeenahmed/freellmapi
BASE_URL=http://127.0.0.1:31415
API_KEY=freellmapi-your-unified-key
MODEL=auto
# Optional: path to the FreeLLMAPI desktop app; EDITH starts it if BASE_URL isn't answering.
FREELLMAPI_APP=
# Microphone loudness threshold (0.0 to 1.0). Raise it if background noise starts recordings.
MIC_THRESHOLD=0.01
WAKE_WORD=edith

# Optional central household mode. Keep credential files outside the repository.
EDITH_HUB_CLIENT_CONFIG=
# Absolute local directory for models/logs/runtime state; empty keeps legacy data/.
EDITH_DATA_DIR=
# llama_cpp (legacy default) or ollama (reuse an installed local model; no auto pull).
EDITH_LOCAL_PROVIDER=llama_cpp
EDITH_OLLAMA_URL=http://127.0.0.1:11434
EDITH_OLLAMA_MODEL=qwen3:4b-instruct
# Optional semantic search; owner indexes chosen documents explicitly through hub_admin.
# Installed model only, no implicit download. Empty keeps keyword retrieval.
EDITH_EMBEDDING_MODEL=
# Optional protected JSON binding one paired adult/elder to a source project and staging directory.
EDITH_WORKSPACE_CONFIG=
# Optional protected account.json from explicit household Gmail onboarding.
# Runtime never starts OAuth; the paired adult/elder principal must match.
EDITH_GMAIL_ACCOUNT_CONFIG=
# Optional protected merchant.json for the paired member's exact allowlisted Shopify store.
# Configure tokenless or a public Storefront access token locally; never an Admin API token.
EDITH_MERCHANT_CONFIG=
# Optional protected WhatsApp Business connection.json from explicit local setup.
# Worker credentials have separate server scopes; startup never contacts Meta.
EDITH_WHATSAPP_CONNECTION_CONFIG=
# Telegram accepts this person's private chat only; remote tools are public-info-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
